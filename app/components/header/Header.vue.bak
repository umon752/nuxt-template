<script setup lang="ts">
import { ref, nextTick, watch, onMounted, onBeforeUnmount } from 'vue'
import Accordion from '~/components/Accordion.vue'
import HeaderMenu from '~/components/header/HeaderMenu.vue'
import { siteConfig } from '~/config/site'
const { t } = useI18n()

type MenuItem = {
  title: string
  href?: string
  children?: MenuItem[]
}

const menuItems = ref<MenuItem[]>([
  { title: '首頁', href: '/' },
  { title: '範例', href: '/sample' },
  {
    title: '服務',
    children: [
      { title: '設計', href: '/services/design' },
      { title: '開發', href: '/services/development' },
      {
        title: '顧問',
        children: [
          { title: '策略顧問', href: '/services/consulting/strategy' },
          { title: '技術顧問', href: '/services/consulting/technical' },
        ],
      },
    ],
  },
  {
    title: '文件',
    children: [
      { title: '指南', href: '/docs' },
      { title: '部落格', href: '/blog' },
    ],
  },
  { title: '聯絡', href: '/contact' },
])

const isMobileMenuOpen = ref(false)
const activePath = ref<number[]>([])
const hamburgerBtn = ref<HTMLButtonElement | null>(null)
const mobileMenuRef = ref<HTMLElement | null>(null)

const onResize = () => {
  if (activePath.value.length) adjustSubmenuForPath(activePath.value)
}

function toggleMobileMenu() {
  isMobileMenuOpen.value = !isMobileMenuOpen.value
}

function closeMobileMenu() {
  isMobileMenuOpen.value = false
}

function handleKeydown(e: KeyboardEvent) {
  if (e.key === 'Escape') {
    closeMobileMenu()
    clearActivePath()
  }

  if (e.key === 'Tab' && isMobileMenuOpen.value && mobileMenuRef.value) {
    const focusable = Array.from(
      mobileMenuRef.value.querySelectorAll<HTMLElement>(
        'a,button,textarea,input,select,[tabindex]:not([tabindex="-1"])'
      )
    ).filter((el) => !el.hasAttribute('disabled'))

    if (focusable.length === 0) {
      e.preventDefault()
      return
    }

    const first = focusable[0]
    const last = focusable[focusable.length - 1]

    if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault()
      first?.focus()
    } else if (e.shiftKey && document.activeElement === first) {
      e.preventDefault()
      last?.focus()
    }
  }
}

watch(isMobileMenuOpen, async (open) => {
  if (open) {
    await nextTick()
    const el = mobileMenuRef.value
    const first = el?.querySelector<HTMLElement>('a,button') ?? null
    first?.focus()
    document.addEventListener('keydown', handleKeydown)
    window.addEventListener('resize', onResize)
  } else {
    document.removeEventListener('keydown', handleKeydown)
    window.removeEventListener('resize', onResize)
    hamburgerBtn.value?.focus()
  }
})

function isPathOpen(path: number[]) {
  for (let i = 0; i < path.length; i++) {
    if (activePath.value[i] !== path[i]) return false
  }
  return activePath.value.length >= path.length
}

function setActivePath(path: number[]) {
  activePath.value = path.slice()
  nextTick(() => adjustSubmenuForPath(path))
}

function clearActivePath() {
  activePath.value = []
}

function toggleActivePath(path: number[]) {
  if (isPathOpen(path)) clearActivePath()
  else setActivePath(path)
}

function adjustSubmenuForPath(path: number[]) {
  const key = path.join('-')
  const selector = `[data-submenu="${key}"]`
  const el = document.querySelector(selector) as HTMLElement | null
  if (!el) return

  el.style.left = ''
  el.style.right = ''
  el.style.transformOrigin = ''

  const rect = el.getBoundingClientRect()
  const padding = 8

  if (rect.right > window.innerWidth - padding) {
    el.style.right = '0px'
    el.style.left = 'auto'
    el.style.transformOrigin = 'right top'
  } else if (rect.left < padding) {
    el.style.left = '0px'
    el.style.right = 'auto'
    el.style.transformOrigin = 'left top'
  } else {
    el.style.left = '0px'
    el.style.right = 'auto'
    el.style.transformOrigin = 'left top'
  }
}

onMounted(() => {
  window.addEventListener('resize', onResize)
})

onBeforeUnmount(() => {
  document.removeEventListener('keydown', handleKeydown)
  window.removeEventListener('resize', onResize)
})
</script>

<template>
  <header role="banner" class="sticky top-0 z-40 border-b bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <!-- Logo -->
        <div class="shrink-0">
          <a href="/" aria-label="首頁">
            <img
              :src="siteConfig.logo || '/images/logo.png'"
              :alt="`${t('site.name')} logo`"
              class="h-8 w-auto"
            />
          </a>
        </div>

        <!-- Desktop nav -->
        <nav class="hidden items-center md:flex" aria-label="主選單">
          <HeaderMenu
            :items="menuItems"
            :active-path="activePath"
            :set-active-path="setActivePath"
            :clear-active-path="clearActivePath"
            :toggle-active-path="toggleActivePath"
            :adjust-submenu="adjustSubmenuForPath"
          />
        </nav>

        <!-- Mobile hamburger -->
        <div class="flex items-center md:hidden">
          <button
            ref="hamburgerBtn"
            :aria-expanded="isMobileMenuOpen"
            :aria-controls="'mobile-menu'"
            aria-label="主選單"
            class="rounded-md p-2 focus:ring focus:outline-none"
            @click="toggleMobileMenu"
          >
            <span v-if="!isMobileMenuOpen" aria-hidden="true">☰</span>
            <span v-else aria-hidden="true">✕</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile menu panel -->
    <div
      v-show="isMobileMenuOpen"
      id="mobile-menu"
      ref="mobileMenuRef"
      role="dialog"
      aria-modal="true"
      class="md:hidden"
    >
      <div class="border-t bg-white shadow-md">
        <div class="mx-auto max-w-7xl px-4 py-4">
          <Accordion :items="menuItems" :collapse-others="false">
            <template #title="{ item }">
              <div class="flex w-full items-center justify-between">
                <span>{{ item.title }}</span>
                <span v-if="item.children" aria-hidden="true">▾</span>
              </div>
            </template>

            <template #content="{ item }">
              <div v-if="(item as any).children">
                <ul class="pl-4">
                  <li v-for="(child, ci) in (item as any).children" :key="ci" class="py-2">
                    <a :href="(child as any).href || '#'" class="block">{{
                      (child as any).title
                    }}</a>
                    <ul v-if="(child as any).children" class="pl-4">
                      <li v-for="(grand, gi) in (child as any).children" :key="gi" class="py-1">
                        <a :href="(grand as any).href || '#'" class="block">{{
                          (grand as any).title
                        }}</a>
                      </li>
                    </ul>
                  </li>
                </ul>
              </div>
              <div v-else>
                <a :href="(item as any).href || '#'" class="block py-2">{{
                  (item as any).title
                }}</a>
              </div>
            </template>
          </Accordion>
        </div>
      </div>
    </div>
  </header>
</template>

<style scoped>
.menu-link {
  display: block;
  padding: 0.5rem 0.75rem;
}
#mobile-menu {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  z-index: 50;
}
button:focus,
a:focus {
  outline: 2px solid rgba(59, 130, 246, 0.5);
  outline-offset: 2px;
}
</style>
