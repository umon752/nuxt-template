<template>
  <ul>
    <li
      v-for="(item, idx) in items"
      :key="idx"
      class="relative"
      @mouseenter="onMouseEnter([...path, idx])"
      @mouseleave="onMouseLeave"
    >
      <div v-if="item.children">
        <button
          type="button"
          class="flex items-center gap-2 px-3 py-2 hover:bg-gray-50 focus:ring focus:outline-none"
          :aria-expanded="isPathOpen([...path, idx])"
          aria-haspopup="true"
          @click.prevent="onToggle([...path, idx])"
          @focus="onMouseEnter([...path, idx])"
        >
          {{ item.title }}
          <span aria-hidden="true" class="ml-1">▾</span>
        </button>

        <div
          v-show="isPathOpen([...path, idx])"
          :data-submenu="[...path, idx].join('-')"
          class="absolute top-full left-0 z-50 mt-2 min-w-48 bg-white shadow-lg"
          role="menu"
          @mouseenter="onMouseEnter([...path, idx])"
          @mouseleave="onMouseLeave"
        >
          <HeaderMenu
            :items="item.children"
            :path="[...path, idx]"
            :active-path="activePath"
            :set-active-path="setActivePath"
            :clear-active-path="clearActivePath"
            :toggle-active-path="toggleActivePath"
            :adjust-submenu="adjustSubmenu"
          />
        </div>
      </div>

      <div v-else>
        <a :href="item.href || '#'" class="block px-3 py-2 hover:bg-gray-50" role="menuitem">{{
          item.title
        }}</a>
      </div>
    </li>
  </ul>
</template>

<script setup lang="ts">
import { nextTick } from 'vue'

type MenuItem = {
  title: string
  href?: string
  children?: MenuItem[]
}

const props = defineProps<{
  items: MenuItem[]
  path?: number[]
  activePath: number[]
  setActivePath: (p: number[]) => void
  clearActivePath: () => void
  toggleActivePath: (p: number[]) => void
  adjustSubmenu: (p: number[]) => void
}>()

const items = props.items
const path = props.path ?? []
const activePath = props.activePath
const setActivePath = props.setActivePath
const clearActivePath = props.clearActivePath
const toggleActivePath = props.toggleActivePath
const adjustSubmenu = props.adjustSubmenu

function isPathOpen(checkPath: number[]) {
  for (let i = 0; i < checkPath.length; i++) {
    if (activePath[i] !== checkPath[i]) return false
  }
  return activePath.length >= checkPath.length
}

function onMouseEnter(checkPath: number[]) {
  setActivePath(checkPath)
  nextTick(() => {
    adjustSubmenu(checkPath)
  })
}

function onMouseLeave() {
  clearActivePath()
}

function onToggle(checkPath: number[]) {
  toggleActivePath(checkPath)
  nextTick(() => {
    adjustSubmenu(checkPath)
  })
}
</script>
